# Önde Caddy: sertifikayı kendi alır, sıkıştırır, statikleri kendisi verir,
# geri kalan her şeyi gunicorn'a geçirir.

{
	email {$ACME_EMAIL}

	servers {
		# Yalnızca bu adreslerden gelen X-Forwarded-For'a inanılır. Liste
		# Cloudflare'in yayınladığı aralıklar (https://www.cloudflare.com/ips/);
		# değişirse burayı güncelle. Gerçek koruma yine güvenlik grubu:
		# 80/443 sadece bu aralıklara açık olmalı ki origin'e doğrudan
		# ulaşılamasın.
		trusted_proxies static \
			173.245.48.0/20 \
			103.21.244.0/22 \
			103.22.200.0/22 \
			103.31.4.0/22 \
			141.101.64.0/18 \
			108.162.192.0/18 \
			190.93.240.0/20 \
			188.114.96.0/20 \
			197.234.240.0/22 \
			198.41.128.0/17 \
			162.158.0.0/15 \
			104.16.0.0/13 \
			104.24.0.0/14 \
			172.64.0.0/13 \
			131.0.72.0/22 \
			2400:cb00::/32 \
			2606:4700::/32 \
			2803:f800::/32 \
			2405:b500::/32 \
			2405:8100::/32 \
			2a06:98c0::/29 \
			2c0f:f248::/32
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Statik adresler içerik özetini (?v=...) taşır, bu yüzden bir yıl
	# önbelleklemek güvenli: içerik değişince adres de değişir.
	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		header -Last-Modified
		file_server
	}

	reverse_proxy web:8000

	log {
		output stdout
		format console
	}
}

# Cloudflare Origin CA sertifikası kullanmak isterseniz, yukarıdaki bloğun
# içine şunu ekleyip otomatik HTTPS'i devre dışı bırakabilirsiniz:
#
#	tls /certs/origin.pem /certs/origin.key
#
# Bu durumda sertifika dosyalarını caddy servisine salt okunur bağlayın.
