# Production settings. Copy to .env.production and fill in the blanks.
# Real values never go into the repository; .env.production is ignored.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production

FLASK_APP=muamma
FLASK_DEBUG=0

# openssl rand -hex 32. Changing it invalidates every session cookie, so
# players lose their progress.
SECRET_KEY=

APP_TIMEZONE=Europe/Istanbul

# Used for share text, canonical links and the sitemap. No trailing slash.
SITE_URL=https://muamma.example
# The domain Caddy serves. Its certificate is the Cloudflare Origin CA
# pair in certs/origin.pem and certs/origin.key; see docs/deploy.md.
SITE_DOMAIN=muamma.example
CONTACT_EMAIL=

# HTTPS-only cookie, plus a one year HSTS header.
SESSION_COOKIE_SECURE=1
HSTS_ENABLED=1

# Client -> Cloudflare -> Caddy -> gunicorn is two proxy hops; the rate
# limiter finds the real address this way. See docs/decisions.md.
TRUSTED_PROXY_HOPS=2

# compose.prod.yaml builds DATABASE_URL and RATELIMIT_STORAGE_URI from
# these.
POSTGRES_DB=muamma
POSTGRES_USER=muamma
POSTGRES_PASSWORD=

# Backups. Access comes from the instance IAM role; no keys here.
AWS_REGION=eu-north-1
BACKUP_BUCKET=
BACKUP_PREFIX=muamma
BACKUP_KEEP_DAYS=30
BACKUP_AT=03:15
