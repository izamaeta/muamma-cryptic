# Canlı ortam ayarları. Bu dosyayı .env.production olarak kopyala ve
# boşlukları doldur. Gerçek değerleri asla depoya koymayın:
# .env.production .gitignore'da.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production

FLASK_APP=muamma
FLASK_DEBUG=0

# openssl rand -hex 32 çıktısını buraya yaz. Değiştirirsen bütün
# oyuncuların oturum çerezi geçersiz olur, ilerlemeleri kaybolur.
SECRET_KEY=

APP_TIMEZONE=Europe/Istanbul

# Sitenin kendi adresi: paylaşım metinleri, canonical ve sitemap buradan
# üretilir. Sonunda eğik çizgi olmasın.
SITE_URL=https://muamma.example
# Caddy'nin sertifika aldığı alan adı ve Let's Encrypt bildirim adresi.
SITE_DOMAIN=muamma.example
ACME_EMAIL=
CONTACT_EMAIL=

# Çerez yalnızca HTTPS üzerinden gider ve tarayıcıya "bu siteye bir yıl
# boyunca hep HTTPS ile gel" denir.
SESSION_COOKIE_SECURE=1
HSTS_ENABLED=1

# İstemci → Cloudflare → Caddy → gunicorn: iki vekil atlaması. Hız sınırı
# oyuncunun gerçek adresini buradan bulur. Ayrıntı: docs/decisions.md
TRUSTED_PROXY_HOPS=2

# Veritabanı. DATABASE_URL ve RATELIMIT_STORAGE_URI'yi compose.prod.yaml
# kendisi kurar; burada sadece kullanıcı, şifre ve veritabanı adı gerekli.
POSTGRES_DB=muamma
POSTGRES_USER=muamma
POSTGRES_PASSWORD=

# Yedekler. Erişim sunucunun IAM rolünden gelir; buraya anahtar yazılmaz.
AWS_REGION=eu-central-1
BACKUP_BUCKET=
BACKUP_PREFIX=muamma
BACKUP_KEEP_DAYS=30
BACKUP_AT=03:15
